<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">
    <entity name="App\Domain\Book\BookAuthor" table="book_author">
        <indexes>
            <index name="idx_book_author_author_id" columns="author_id"/>
        </indexes>
        <id name="book" association-key="true"/>
        <id name="authorId" column="author_id" type="integer"/>
        <many-to-one field="book" target-entity="App\Domain\Book\Book" inversed-by="authors">
            <join-column name="book_id" referenced-column-name="id" nullable="false" on-delete="CASCADE"/>
        </many-to-one>
    </entity>
</doctrine-mapping>
